# ===== DASHBOARD (admin panel) =====
# SAME database as the website — both projects must point to the same MongoDB.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/laptop-clinic?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://Vercel-Admin-thearuh:QfKQNSrhpOpcWJ0M@thearuh.al9uhg9.mongodb.net/?retryWrites=true&w=majority"
# Signs the admin login cookie. 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=97e1c25e48b125338cc40dc2411840cdc2119150bb2412d26335cc6b39e27e8e

# This DASHBOARD's public address — admin password-reset links are built from it. REQUIRED in production.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001

# The public WEBSITE's address — used for "View website" and for links inside customer order emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your brand name (shown in the dashboard, emails and messages)
NEXT_PUBLIC_BRAND_NAME=Your Brand
# Prefix of order numbers, e.g. OD-250101-AB12CD
ORDER_PREFIX=OD

# First admin account — created by `npm run seed` / `npm run seed:admin`
ADMIN_NAME=Store owner
ADMIN_EMAIL=admin@yourshop.com
ADMIN_PASSWORD=choose-a-strong-password

# Emails via Resend (reset link + order status emails)
RESEND_API_KEY=
EMAIL_FROM=Laptop Clinic <onboarding@resend.dev>

# Razorpay — same keys as the website (needed to refund cancelled orders)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Shiprocket (optional) — one-click shipping, labels, automatic tracking, return pickups ----
# Create an API user in Shiprocket → Settings → API → "Create API User" (not your normal login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Nickname of your pickup address in Shiprocket → Settings → Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Any secret you choose. In Shiprocket → Settings → API → Webhooks set URL = https://YOUR-DASHBOARD/api/shiprocket/webhook and the same token
SHIPROCKET_WEBHOOK_TOKEN=
# Where returned items should be delivered (for customer return pickups)
SHIPROCKET_WAREHOUSE_NAME=
SHIPROCKET_WAREHOUSE_ADDRESS=
SHIPROCKET_WAREHOUSE_CITY=
SHIPROCKET_WAREHOUSE_STATE=
SHIPROCKET_WAREHOUSE_PINCODE=
SHIPROCKET_WAREHOUSE_PHONE=

# ---- Push notifications (optional): npx web-push generate-vapid-keys ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourbrand.com

# Printed as the "From" address on shipping labels and packing slips
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_PHONE=
